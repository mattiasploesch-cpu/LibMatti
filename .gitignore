# ---- Build directories -------------------------------------------------
build/
build-*/
cmake-build-*/
mods/build/
out/*
!tests/modscan/out/**

# ---- Rust ---------------------------------------------------------------
# The crate is built into the CMake build tree (cmake/MattiRust.cmake); this
# ignores a manual `cargo build` inside the crate folder.
library/src/libmatti/rs/target/
launchers/target/

# ---- Build artifacts ---------------------------------------------------
*.so
*.a
*.o
*.obj
*.dll
*.exe

# ---- Runtime state (created by runClient / matticraft) -----------------
/config/
/night-config/core/
fml.toml
examplemod-client.toml
defaultconfigs/
mods/options.txt
logs/
crash-reports/
saves/
screenshots/
kitchen/
*.log

# ---- Debug / profiling dumps ------------------------------------------
vgcore.*
core.*
/core
lm_nm.txt
*.ppm

# ---- IDE ---------------------------------------------------------------
.idea/*
!.idea/runConfigurations/
!.idea/codeStyles/
.vscode/
*.iml

# ---- OS ---------------------------------------------------------------
.DS_Store
Thumbs.db

# ---- Vendored upstream clones - git submodules (.gitmodules). The clones
# arrive with the repo (git clone --recurse-submodules) but stay outside this
# repository's own code and history.
vendor/*

# ---- CMake generated ---------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
Testing/

# A stray nested clone of this repository (created by IDE tooling)
/LibMatti/
*.bak

# downloaded vanilla jars (tools/fetch_vanilla_gui_assets.py)
.cache/

# release archives generated by packaging/build-all.sh
/dist/
