# ---- Build directories -------------------------------------------------
build/
build-*/
cmake-build-*/
mods/build/
out/

# ---- Build artifacts ---------------------------------------------------
*.so
*.a
*.o
*.obj
*.dll
*.exe

# ---- Runtime state (created by runClient / matticraft) -----------------
config/
defaultconfigs/
mods/options.txt
logs/
crash-reports/
saves/
screenshots/
kitchen/
*.log

# ---- Debug / profiling dumps ------------------------------------------
vgcore.*
core.*
core
lm_nm.txt
*.ppm

# ---- IDE ---------------------------------------------------------------
.idea/*
!.idea/runConfigurations/
!.idea/codeStyles/
.vscode/
*.iml

# ---- OS ---------------------------------------------------------------
.DS_Store
Thumbs.db

# ---- Vendored upstream clones - git submodules (.gitmodules). The clones
# arrive with the repo (git clone --recurse-submodules) but stay outside this
# repository's own code and history.
vendor/*
!vendor/stb/
vendor/stb/*

# ---- CMake generated ---------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
Testing/
