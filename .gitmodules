# The vendor submodules - the upstream Java sources every port file maps to
# 1:1. They are NOT part of the repository's own code and keep their original
# licenses; they are cloned with the repo:
#
#     git clone --recurse-submodules https://github.com/mattiasploesch-cpu/LibMatti.git
#     # or, for an already cloned repo:
#     git submodule update --init --recursive
#
# Pinned at the revisions the port currently references.

[submodule "vendor/AccessTransformer"]
	path = vendor/AccessTransformer
	url = https://github.com/neoforged/AccessTransformers
[submodule "vendor/Bus"]
	path = vendor/Bus
	url = https://github.com/neoforged/Bus.git
[submodule "vendor/FancyModLoader"]
