[submodule "vendor/netty"]
	path = vendor/netty
	url = https://github.com/netty/netty
[submodule "vendor/night-config"]
	path = vendor/night-config
	url = https://github.com/TheElectronWill/night-config.git
[submodule "vendor/securejarhandler"]
