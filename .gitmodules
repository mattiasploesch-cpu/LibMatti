	url = https://github.com/Hexeption/MCP-Reborn.git
[submodule "vendor/NeoForge"]
	path = vendor/NeoForge
	url = https://github.com/neoforged/NeoForge.git
[submodule "vendor/bootstraplauncher"]
	path = vendor/bootstraplauncher
	url = https://github.com/McModLauncher/bootstraplauncher.git
[submodule "vendor/brigadier"]
	path = vendor/brigadier
	url = https://github.com/Mojang/brigadier
